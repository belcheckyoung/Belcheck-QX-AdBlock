#!name=丰巢小程序广告与推广净化
#!desc=清空广告下发、关闭已识别广告开关、清理会员推广；包含未捕获开屏的预防接口，手机效果待验证
#!author=Belcheck
#!homepage=https://github.com/belcheckyoung/Belcheck-QX-AdBlock

# Capture-backed APIs. Keep successful envelopes instead of triggering failed-request fallbacks.
^https?:\/\/(?:dsp\.fcbox\.com\/adSearch\/(?:get|getMulti)|webchatapp\.fcbox\.com\/(?:commerce\/mobile\/appConfig\/getPositions|fcboxactivityweb\/api\/v2\/clientPage\/getUserClientPageInfo|post\/suggestion\/query))\/?(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/belcheckyoung/Belcheck-QX-AdBlock/afc4ec8ed834ed053f71312fbb62242a1a2ae6a2/Scripts/FengChaoAdClean.js
^https?:\/\/(?:dsp\.fcbox\.com\/adSearch\/(?:get|getMulti)|webchatapp\.fcbox\.com\/(?:commerce\/mobile\/appConfig\/getPositions|fcboxactivityweb\/api\/v2\/clientPage\/getUserClientPageInfo|post\/suggestion\/query))\/?(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/belcheckyoung/Belcheck-QX-AdBlock/afc4ec8ed834ed053f71312fbb62242a1a2ae6a2/Scripts/FengChaoAdClean.js
^https?:\/\/dsp\.fcbox\.com\/adTracker\/stat\/?(?:\?.*)?$ url reject-200

# Dedicated ad-media host observed in the capture. No shared consumerapp CDN block.
^https?:\/\/ad-dsp-1251779293\.file\.myqcloud\.com\/ url reject-img
^https?:\/\/consumerapp-1251779293\.file\.myqcloud\.com\/patch\/202512\/(?:%E5%8F%96%E4%BB%B6|取件)_4mdfd5fjvxf\.png(?:\?.*)?$ url reject-img

# Upstream ad-endpoint preventive coverage; not present in this capture and not splash-verified.
^https?:\/\/rtm\.fcbox\.com\/rtsWeb\/api\/resource\/ad\/queryAd\/?(?:\?.*)?$ url reject-dict

# Remove a local -*.fcbox.com exclusion first; remote hostname declarations cannot repair it.
hostname = dsp.fcbox.com, webchatapp.fcbox.com, rtm.fcbox.com, ad-dsp-1251779293.file.myqcloud.com, consumerapp-1251779293.file.myqcloud.com
