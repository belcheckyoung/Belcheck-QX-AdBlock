#!name=哔哩哔哩 App 广告补丁
#!desc=清理新版相关推荐广告卡、已标记首页广告及商业开屏；保留正常视频、评论和播放
#!author=Belcheck
#!homepage=https://github.com/belcheckyoung/Belcheck-QX-AdBlock

^https?:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync(?:\?|$) url script-response-body https://raw.githubusercontent.com/belcheckyoung/Belcheck-QX-AdBlock/85b85020416d3c800fd7d61cb250ac0f5152e77a/Scripts/BilibiliAppAds.js
^https?:\/\/app\.bilibili\.com\/x\/v2\/(?:splash\/list|feed\/index)(?:\?|$) url script-response-body https://raw.githubusercontent.com/belcheckyoung/Belcheck-QX-AdBlock/85b85020416d3c800fd7d61cb250ac0f5152e77a/Scripts/BilibiliAppAds.js

hostname = app.bilibili.com, grpc.biliapi.net
