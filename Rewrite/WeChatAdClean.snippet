#!name=微信公众号广告清理
#!desc=1.0.0 仅清理 getappmsgad 已知顶层广告字段；保留 appid 与其他原文。上游结构兼容性试验，手机效果待验证；不承诺朋友圈、视频号或所有小程序去广告。
#!author=Belcheck; interface reference Choler / NobyDa
#!homepage=https://github.com/belcheckyoung/Belcheck-QX-AdBlock

^https?:\/\/[mM][pP]\.[wW][eE][iI][xX][iI][nN]\.[qQ][qQ]\.[cC][oO][mM]\/mp\/getappmsgad(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/belcheckyoung/Belcheck-QX-AdBlock/main/Scripts/WeChatAdClean.js
hostname = mp.weixin.qq.com
